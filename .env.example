# ── Fistotex environment variables ───────────────────────────────────
# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables.
# No secrets are required for the site to work — the news page reads
# public RSS feeds and needs no API key.

# Canonical public URL. Used for metadata, canonical tags, sitemap and
# structured data. Set this in production or canonical URLs will point at
# localhost.
NEXT_PUBLIC_SITE_URL=https://www.fistotex.com

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Leave empty to disable analytics entirely — no script is loaded.
NEXT_PUBLIC_GA_ID=

# Shown in the footer and in Organization structured data.
CONTACT_EMAIL=contact@fistotex.com
SITE_OWNER_NAME=Fistotex

# Optional: postal address for Organization structured data.
BUSINESS_ADDRESS=

# ── Optional news tuning ────────────────────────────────────────────
# The news page aggregates RSS feeds configured in src/config/site.ts.
# No API keys are needed. To add or remove publishers, edit
# `siteConfig.news.sources` there.

# ── Contact form email delivery (Resend — https://resend.com) ────────
# Without RESEND_API_KEY the contact form does NOT pretend to send: it
# offers to open the visitor's email app with the message pre-filled.
RESEND_API_KEY=
# Inbox that receives contact messages (defaults to CONTACT_EMAIL).
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "Fistotex <hello@fistotex.com>".
# If empty, Resend's test sender is used, which can only deliver to the
# email address that owns the Resend account.
CONTACT_FROM_EMAIL=

# ── Google AdSense ──────────────────────────────────────────────────
# The publisher ID is public (it ships in every page), so the default in
# src/config/site.ts is the live one and these vars are only for overrides.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-1157495262514467
# Set to "false" to pull every ad unit and the loader script (e.g. on a
# staging deployment, which must never serve live ads).
NEXT_PUBLIC_ADSENSE_ENABLED=
# Ad unit slot IDs from AdSense -> Ads -> By ad unit. An empty slot renders
# nothing at all, so pages stay clean until the unit actually exists.
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY=
