# ── Fistotex environment variables ───────────────────────────────────
# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables.
# No secrets are required for the site to work — the news page reads
# public RSS feeds and needs no API key.

# Canonical public URL. Used for metadata, canonical tags, sitemap and
# structured data. Set this in production or canonical URLs will point at
# localhost.
NEXT_PUBLIC_SITE_URL=https://www.fistotex.com

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Leave empty to disable analytics entirely — no script is loaded.
NEXT_PUBLIC_GA_ID=

# Shown in the footer and in Organization structured data.
CONTACT_EMAIL=contact@fistotex.com
SITE_OWNER_NAME=Fistotex

# Optional: postal address for Organization structured data.
BUSINESS_ADDRESS=

# ── Optional news tuning ────────────────────────────────────────────
# The news page aggregates RSS feeds configured in src/config/site.ts.
# No API keys are needed. To add or remove publishers, edit
# `siteConfig.news.sources` there.
